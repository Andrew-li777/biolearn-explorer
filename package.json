{
  "name": "biolearn-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:check": "node scripts/check-data.mjs && node scripts/extract-cases.mjs --check",
    "data:sync": "node scripts/sync-data.mjs",
    "data:extract-cases": "node scripts/extract-cases.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "lucide-react": "^0.468.0",
    "echarts": "^5.6.0",
    "@radix-ui/react-dialog": "^1.1.6"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.50.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  }
}
